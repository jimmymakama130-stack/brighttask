@app.route("/submit-task", methods=["POST"])
def submit_task():
    user = current_user()

    if not user:
        return redirect("/login.html")

    if not user.get("activated", False):
        return redirect("/activate")

    task_id = request.form.get("task_id", "").strip()
    proof = request.form.get("proof", "").strip()

    if not task_id or not proof:
        return "Task ID and proof are required.", 400

    tasks = load_tasks()
    task = next(
        (t for t in tasks if t.get("id") == task_id),
        None
    )

    if not task:
        return "Task not found.", 404

    if task.get("status") != "Active":
        return "This task is no longer available.", 400

    if task.get("creator_id") == user.get("id"):
        return "You cannot submit your own task.", 403

    submissions = load_submissions()

    existing = next(
        (
            sub for sub in submissions
            if sub.get("task_id") == task_id
            and sub.get("worker_id") == user.get("id")
            and sub.get("status") == "Pending"
        ),
        None
    )

    if existing:
        return "You already have a pending submission for this task.", 400

    submission = {
        "id": os.urandom(8).hex(),
        "task_id": task_id,
        "creator_id": task.get("creator_id"),
        "worker_id": user.get("id"),
        "worker_name": (
            f"{user.get('first_name', '')} "
            f"{user.get('last_name', '')}"
        ).strip(),
        "task_title": task.get("title", ""),
        "reward": task.get("cost_per_worker", 0),
        "proof": proof,
        "status": "Pending"
    }

    submissions.append(submission)
    save_submissions(submissions)

    for stored_task in tasks:
        if stored_task.get("id") == task_id:
            stored_task["submitted"] = int(
                stored_task.get("submitted", 0)
            ) + 1
            break

    save_tasks(tasks)

    return redirect("/my-submissions.html")


