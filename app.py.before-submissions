import json
import os

app = Flask(__name__)

app.secret_key = os.environ.get(
    "TASKBRIGHT_SECRET",
    "taskbright-development-secret-change-later"
)

BASE_DIR = Path(__file__).resolve().parent
VIEWS_DIR = BASE_DIR / "views"
DATA_DIR = BASE_DIR / "data"
