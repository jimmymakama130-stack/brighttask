@app.route("/<page>")
def page(page):
    if not page.endswith(".html"):
        page += ".html"

    file_path = VIEWS_DIR / page

    if not file_path.is_file():
        return "Page not found", 404

    return send_from_directory(VIEWS_DIR, page)


